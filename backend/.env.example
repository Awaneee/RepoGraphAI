# RepoGraphAI environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# LLM provider (at least one key required for /qa LLM responses)
# Without a key, /qa returns the graph retrieval context without an LLM answer.
# ---------------------------------------------------------------------------

# Anthropic Claude (recommended)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (alternative)
# GOOGLE_API_KEY=AIza...

# Which provider to use when both keys are set (default: anthropic)
# DEFAULT_LLM_PROVIDER=anthropic

# Anthropic model to use (default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Storage directories (relative to process working directory)
# ---------------------------------------------------------------------------

# Where cloned repositories are stored
# REPOS_DIR=repos

# Where graph cache files are stored
# CACHE_DIR=.cache

# ---------------------------------------------------------------------------
# Security limits
# ---------------------------------------------------------------------------

# Maximum repository size in MB before rejecting the clone (default: 500)
# MAX_REPO_SIZE_MB=500

# Git clone timeout in seconds (default: 60, Unix only via SIGALRM)
# CLONE_TIMEOUT_SECONDS=60

# Allowed git hosting domains (comma-separated)
# ALLOWED_CLONE_HOSTS=github.com,gitlab.com,bitbucket.org

# ---------------------------------------------------------------------------
# NOT USED — this project does not use Redis, Kubernetes, or vector databases
# ---------------------------------------------------------------------------
